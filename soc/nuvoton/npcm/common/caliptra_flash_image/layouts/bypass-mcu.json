{
  "version": "bypass-mcu",
  "description": "Bypass-Caliptra flash image, MCU-firmware variant: MCU ROM loads and jumps to the MCU firmware, which boots the SoC firmware. Partition table at 0, single valid slot A at slot_base_offset.",
  "slot_base_offset": "0x10000",
  "partition": { "active": "a", "a": "valid", "b": "invalid", "rollback": "enable" },
  "images": [
    { "id": "0x00000000", "name": "caliptra_fw",  "reserved": true },
    { "id": "0x00000001", "name": "soc_manifest", "reserved": true },
    { "id": "0x00000002", "name": "mcu_runtime",  "source": "mcu-fw" },
    { "id": "0x00001000", "name": "soc_fw",       "source": "soc-fw" },
    { "id": "0x00001001", "name": "npcm_header",  "source": "soc-header" },
    { "id": "0x00001002", "name": "flash_otp",    "reserved": true }
  ]
}
