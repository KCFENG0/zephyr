config SOC_SERIES_NPCM5
	select ARM
	select CPU_CORTEX_M7
	select CPU_CORTEX_M_HAS_DWT
	select SOC_FAMILY_NPCM
	select CPU_HAS_ARM_MPU
	select CPU_HAS_CUSTOM_FIXED_SOC_MPU_REGIONS
	select CPU_HAS_FPU
	select CPU_HAS_ICACHE
	select CPU_HAS_DCACHE
	select CLOCK_CONTROL
	select SOC_RESET_HOOK
	select SOC_LATE_INIT_HOOK
	help
	  Enable support for Nuvoton NPCM5 series

config FLASH_SIZE
	int "Flash Size in kB"
	default $(dt_chosen_reg_size_int,$(DT_CHOSEN_Z_FLASH),0,K) if !XIP
	help
	  This option specifies the size of the flash in kB.  It is normally set by
	  the board's defconfig file and the user should generally avoid modifying
	  it via the menu configuration.

config FLASH_BASE_ADDRESS
	hex "Flash Base Address"
	default $(dt_chosen_reg_addr_hex,$(DT_CHOSEN_Z_FLASH)) if !XIP
	help
	  This option specifies the base address of the flash on the board. It is
	  normally set by the board's defconfig file and the user should generally
	  avoid modifying it via the menu configuration.

choice GPIO_NPCM_RESET_SL
	prompt "Selects the GPIO reset to the corresponding reset source"
	default GPIO_NPCM_RESET_SL_CORE_DOMAIN

config GPIO_NPCM_RESET_SL_CORE_DOMAIN
	bool "GPIO Reset by Core domain reset"
	help
	  GPIO port 0-9, A-F is reset by Core domain reset.

config GPIO_NPCM_RESET_SL_POWER_UP
	bool "GPIO Reset by VSB Power-Up reset"
	help
	GPIO port 0-9, A-F is reset by VSB Power-Up reset.
endchoice

# The chip revision comes from the board revision (-b npcm500_evb@a2), not a
# prompt: the devicetree is built before Kconfig and differs per revision too,
# so a second switch here could disagree with it.
config NPCM500_REV_A2
	def_bool "$(BOARD_REVISION)" = "a2"
	depends on SOC_SERIES_NPCM5
	help
	  Revision in development, FPGA only for now. Its MCU ROM parses only
	  v3 flash images and boots only through Caliptra. Whether the target
	  is the FPGA is separate: CONFIG_NPCM500_FPGA.

config NPCM500_REV_A1
	def_bool !NPCM500_REV_A2
	depends on SOC_SERIES_NPCM5
	help
	  Taped-out revision, on the EVB and on the FPGA. Its MCU ROM parses
	  v1 flash images and boots in bypass or Caliptra mode.

config PLATFORM_SPECIFIC_INIT
	default n if SOC_SERIES_NPCM5
	help
	  Disable deprecated PLATFORM_SPECIFIC_INIT for NPCM5 as it uses SOC_RESET_HOOK instead.

config SOC_NPCM5_HYPERRAM_MPU_DEVICE
	bool "Map HyperRAM (0x90000000) as Device Shareable in MPU"
	depends on SOC_SERIES_NPCM5
	default n
	help
	  When enabled, the FIU1 DRA HyperRAM window (0x90000000-0x9FFFFFFF)
	  is mapped as Device Shareable (TEX=0, C=0, B=1, S=1) in the MPU.

	  Without this, the CM7 write buffer may issue 32-bit volatile stores
	  as narrow (AWSIZE=2) AXI SINGLE beats. The FIU DRA slave rejects
	  sub-bus-width SINGLE transactions with SLVERR, causing a BUS FAULT
	  on any isolated 32-bit write.

	  Device Shareable forces each store to be a non-bufferable, strongly-
	  ordered AXI transaction at full 64-bit bus width (AWSIZE=3) with
	  WSTRB byte enables, which the FIU DRA accepts.

	  Note: This is a workaround for FPGA validation. Whether silicon
	  requires this mapping depends on the final FIU DRA AXI slave design.
