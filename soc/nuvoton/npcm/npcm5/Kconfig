config SOC_SERIES_NPCM5
	select ARM
	select CPU_CORTEX_M7
	select CPU_CORTEX_M_HAS_DWT
	select SOC_FAMILY_NPCM
	select CPU_HAS_ARM_MPU
	select CPU_HAS_FPU
	select CLOCK_CONTROL
	select SOC_RESET_HOOK
	select SOC_LATE_INIT_HOOK
	help
	  Enable support for Nuvoton NPCM5 series

config PLATFORM_SPECIFIC_INIT
	default n if SOC_SERIES_NPCM5
	help
	  Disable deprecated PLATFORM_SPECIFIC_INIT for NPCM5 as it uses SOC_RESET_HOOK instead.
