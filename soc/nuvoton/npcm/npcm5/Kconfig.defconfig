if SOC_SERIES_NPCM5

config NUM_IRQS
	default 82

config CORTEX_M_SYSTICK
	default !NPCM_ITIM_SYSTICK

DT_CHOSEN_Z_FLASH := zephyr,flash

config ROM_START_OFFSET
	default 0x600 if XIP
	default 0x0   if !XIP

endif # SOC_SERIES_NPCM5
