# NPCM WDT driver configuration options

# Copyright (c) 2024 Nuvoton Technology Corporation.
# SPDX-License-Identifier: Apache-2.0

config WDT_NPCM
	bool "Nuvoton NPCM Watchdog Timer driver"
	default y
	depends on DT_HAS_NUVOTON_NPCM_WATCHDOG_ENABLED
	select HAS_WDT_DISABLE_AT_BOOT
	help
	  This option enables the Watchdog Timer driver for the Nuvoton NPCM
	  family of processors.

config WDT_NPCM_WARNING_LEADING_TIME_MS
	int "Milliseconds before generating watchdog reset"
	depends on WDT_NPCM
	default 500
	help
	  When a timeout callback is installed, this option defines the window
	  between the watchdog event (callback) and the SoC reset. The window
	  is rounded up to the watchdog clock period of the selected timeout
	  range.
