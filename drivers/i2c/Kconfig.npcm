# NPCM I2C driver configuration options

# Copyright (c) 2024 Nuvoton Technology Corporation.
# SPDX-License-Identifier: Apache-2.0

config I2C_NPCM
	bool "Nuvoton NPCM I2C driver"
	default y
	depends on DT_HAS_NUVOTON_NPCM_I2C_ENABLED
	help
	  This option enables the I2C driver for NPCM family of
	  processors.
	  Say y to use I2C modules on NPCM MCU.

config CONTROLLER_HW_TIMEOUT_EN
	bool "Controller hardware timeout"
	default n
	help
	  Arm the SCL low and START-to-STOP timeout detectors for the
	  duration of each controller transfer. When one expires the module
	  is reset to release the bus and the transfer fails with -ETIMEDOUT.
	  Ignored when TARGET_HW_TIMEOUT_EN is set, which keeps the detectors
	  armed all the time.

config CONTROLLER_HW_TIMEOUT_CLK_CYCLE_TIME
	depends on CONTROLLER_HW_TIMEOUT_EN
	int "Controller hardware timeout clock cycle time"
	default 50
	range 0 255
	help
	  Longest time from START to STOP, in milliseconds.

config CONTROLLER_HW_TIMEOUT_CLK_LOW_TIME
	depends on CONTROLLER_HW_TIMEOUT_EN
	int "Controller hardware timeout clock low time"
	default 25
	range 0 255
	help
	  Longest cumulative time SCL may be held low within one
	  transaction, in milliseconds (SMBus tTIMEOUT is 25-35 ms).

config TARGET_HW_TIMEOUT_EN
	bool "Target hardware timeout"
	default n
	help
	  Keep the SCL low and START-to-STOP timeout detectors armed while
	  the module is enabled. When one expires the module is reset, which
	  releases a bus held by this module (for example SCL stretched
	  while an interrupt is never serviced) and drops the transaction.
	  Note that when using Quick command (SMBUS), do not enable target timeout.

config TARGET_HW_TIMEOUT_CLK_LOW_TIME
	depends on TARGET_HW_TIMEOUT_EN
	int "Target hardware timeout clock low time"
	default 25
	range 0 255
	help
	  Longest cumulative time SCL may be held low within one
	  transaction, in milliseconds (SMBus tTIMEOUT is 25-35 ms).

config TARGET_HW_TIMEOUT_CLK_CYCLE_TIME
	depends on TARGET_HW_TIMEOUT_EN
	int "Target hardware timeout clock cycle time"
	default 50
	range 0 255
	help
	  Longest time from START to STOP, in milliseconds.
