CONFIG_SRAM_VECTOR_TABLE=y
CONFIG_BOOTLOADER_SRAM_SIZE=0
# General Kernel Options
CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=96000000
CONFIG_XIP=n

CONFIG_FPU=y
# CONFIG_ARM_MPU=y
# CONFIG_NPCM_ITIM_SYSTICK=y

# Clock Driver
CONFIG_CLOCK_CONTROL=y

# Pinctrl Driver
CONFIG_PINCTRL=y

# UART Driver
CONFIG_SERIAL=y
CONFIG_UART_INTERRUPT_DRIVEN=y
CONFIG_UART_SHELL=y
CONFIG_UART_USE_RUNTIME_CONFIGURE=y

# Console Driver
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# GPIO Driver
CONFIG_GPIO=y
CONFIG_GPIO_SHELL=y

# SGPIO Driver
CONFIG_SGPIO_NPCM=y

# Flash Driver
CONFIG_FLASH=y
CONFIG_FLASH_SHELL=y

# SPI Driver
CONFIG_SPI=y
CONFIG_SPI_SHELL=y

# Watchdog Driver
CONFIG_WATCHDOG=y

# ADC Driver
CONFIG_ADC=y

# I2C Driver
CONFIG_I2C=y

# USBD Driver
CONFIG_USB_DEVICE_DRIVER=y

# Networking config
CONFIG_NETWORKING=y
CONFIG_NET_L2_ETHERNET=y
CONFIG_NET_IPV4=y
CONFIG_NET_IPV6=n
CONFIG_NET_TCP=y
CONFIG_NET_SOCKETS=y
CONFIG_POSIX_API=y
CONFIG_NET_SHELL=y

# Network driver config
CONFIG_TEST_RANDOM_GENERATOR=y

# Counter Driver
CONFIG_COUNTER=y
CONFIG_COUNTER_SHELL=y

# TACH Driver
CONFIG_SENSOR=y

# PWM Driver
CONFIG_PWM=y
CONFIG_PWM_SHELL=y

# PWM LED Driver
CONFIG_LED=y
CONFIG_LED_SHELL=y

#I3C Driver
CONFIG_I3C=y
CONFIG_I3C_USE_IBI=y
CONFIG_I3C_SHELL=y

# C2H Driver
CONFIG_C2H_NPCM=y

# RTC Driver
CONFIG_RTC=y
CONFIG_RTC_ALARM=y
CONFIG_RTC_NPCM=y

# eSPI Driver
CONFIG_ESPI=y
CONFIG_ESPI_NPCM=y
CONFIG_ESPI_TAF_NPCM=y
CONFIG_ESPI_NPCM_FLASH_SAFS_HW_MODE=y

# IPMI Driver
CONFIG_IPMI=y
CONFIG_IPMI_KCS_NPCM=y

# HWINFO Driver
CONFIG_HWINFO=y

# fs
CONFIG_FILE_SYSTEM=y
CONFIG_SHELL_BACKEND_SERIAL_RX_RING_BUFFER_SIZE=128
CONFIG_FILE_SYSTEM_LITTLEFS=y
CONFIG_FLASH_MAP=y
