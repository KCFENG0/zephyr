};

&i3c1 {
	i3c-scl-hz = <12500000>;
	i3c-od-scl-hz = <4170000>;
	i2c-scl-hz = <1000000>;
	pinctrl-0 = <&i3c1_scl_sda_gpio21_22>;
	bcr = <0x26>;
	secondary;
	pinctrl-names = "default";
	status = "disabled";
};

