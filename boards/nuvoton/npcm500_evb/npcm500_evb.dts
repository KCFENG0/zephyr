	pinctrl-0 = <&pspi1_clk_gpio66_67_70_73_76_77>;
	pinctrl-names = "default";
	status = "okay";
};

&qspi_fiu0 {
	ext_flash: w25q256jv@0 {
		compatible ="nuvoton,npcm-nor";
		size = <DT_SIZE_M(32 * 8)>;
		reg = <0>;
		enter-4byte-addr = <0xa5>;
		status = "okay";

		/* quad spi bus configuration of nor flash device */
		qspi-flags = <NPCM_QSPI_SW_CS1>;
		mapped-addr = <0x70000000>;
		pinctrl-0 = <&fiu0_shd_cs_io0_io1_clk_gpio44_45_46_47
			     &fiu0_shd_quad_io2_io3_clk_gpio55_56>;
		pinctrl-names = "default";
	};
};

&timer2 {
	prescaler = <2>;
	status = "okay";
};

&pwm5 {
	pinctrl-0 = <&pwm4_gpioa0>;
	pinctrl-names = "default";
	status = "okay";
};

&pwm6 {
       pinctrl-0 = <&pwm5_gpioa3>;
       pinctrl-names = "default";
       status = "okay";
};

&pwm7 {
       pinctrl-0 = <&pwm6_gpioa5>;
       pinctrl-names = "default";
       status = "okay";
};

&tach1 {
	pin-select = <NPCM_TACH_PIN_SELECT_4>; /* Select tach pin 4 as input pin */
	sample-clk = <NPCM_TACH_FREQ_LFCLK>; /* Use LFCLK as sampling clock */
	pulses-per-round = <2>; /* number of pulses per round of encoder */
	pinctrl-0 = <&tach4_gpioa1>;
	pinctrl-names = "default";
	status = "okay";
};

&i3c1 {
	i3c-scl-hz = <12500000>;
	i3c-od-scl-hz = <4170000>;
	i2c-scl-hz = <1000000>;
	pinctrl-0 = <&i3c1_scl_sda_gpio21_22>;
	bcr = <0x26>;
	secondary;
	pinctrl-names = "default";
	status = "disabled";
};

&i3c2 {
